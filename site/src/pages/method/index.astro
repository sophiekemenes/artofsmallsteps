---
import Layout from '../../layouts/Layout.astro';

const steps = [
  { name: 'Values', note: '[TODO] card-sort / bubble-method values ranking, adapted from Lesson 7' },
  { name: 'Roles', note: '[TODO] life-roles cross-referenced with values, adapted from Lesson 11' },
  { name: 'Goals', note: '[TODO] concrete goals from role/value intersections, adapted from Lesson 13' },
  { name: 'Habits', note: '[TODO] "Ten Things to Achieve Your Goal" checklist — goal → milestone → task → habit' },
];
---

<Layout title="The Method">
  <section style="max-width: 720px;">
    <p style="font-family: var(--font-sans); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 var(--space-2);">
      Placeholder copy — structure only
    </p>
    <h1 style="font-size: 36px; font-weight: 400; margin: 0 0 var(--space-3);">The Method</h1>
    <p style="font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 var(--space-4);">
      [TODO: explain the core cascading framework carried over from Újratervezés, and why small steps work (kaizen framing) — see /brand/POSITIONING-DRAFT.md and /source-material/ujratervezes-hu/ANALYSIS.md.]
    </p>

    <div style="display: flex; flex-direction: column; gap: var(--space-2);">
      {steps.map((step, i) => (
        <div style="display: flex; gap: var(--space-3); align-items: baseline; padding: var(--space-3); background: var(--color-surface); border-radius: var(--radius);">
          <span style="font-family: var(--font-sans); font-size: 13px; color: var(--color-text-muted);">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <div style="font-size: 20px; margin-bottom: 4px;">{step.name}</div>
            <div style="font-family: var(--font-sans); font-size: 14px; color: var(--color-text-muted);">{step.note}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

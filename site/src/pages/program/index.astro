---
import Layout from '../../layouts/Layout.astro';

// Structure per /brand/product/RECHART.md — "The Wayfinder Method". Final
// decision 2026-11-01: Find Your Bearings is NOT a separate free funnel —
// it's a free taste embedded on this page (email capture) AND stage 0 of
// the paid package itself, same content doing both jobs. Three paid stages
// below map to specific original Hungarian lessons (see ANALYSIS.md for
// those). Lesson titles within each paid stage are still untranslated
// placeholders — the stage structure and pricing are decided, the
// lesson-level copy is not.
const PRICE_FULL = '£69';
const PRICE_LAUNCH = '£39';

const freeStage = {
  icon: '🧭',
  name: 'Find Your Bearings',
  subtitle: 'free taste — also stage 1 of the full package',
  description: `[TODO: a short, self-contained diagnostic experience built from the original cube/ladder/lion/road/beach symbolic self-test (Lesson 1). Try it free right here, no purchase needed, in exchange for your email — the same piece is also the literal opening stage of the full Wayfinder Method package below. See /brand/product/RECHART.md, stage 0.]`,
  quote: 'Where am I, really?',
};

const phases = [
  {
    n: 1,
    icon: '🧭',
    name: 'Wake Up the Inner Navigator',
    subtitle: 'paid — warm-up / preparation',
    description: '[TODO: where you actually stand right now — not the destination, an exact read of the present moment.]',
    lessons: [
      '[TODO — was "The Downstairs Neighbor"]',
      '[TODO — was "The Protagonist"]',
      '[TODO — was "Value Added"]',
      '[TODO — was "Three Magic Words"]',
      '[TODO — was "Free Fall"]',
      '[TODO — was "Finger Exercise"]',
    ],
  },
  {
    n: 2,
    icon: '🗺️',
    name: 'Draw Your Other Map',
    subtitle: 'paid — planning',
    description: '[TODO: once the navigator is awake, name the direction you were already building toward — deliberately yours, not a new map, just an honest one.]',
    lessons: [
      '[TODO — was "Valuable Bubbles"]',
      '[TODO — was "Energy Crest"]',
      '[TODO — was "One (or More) Above All"]',
      '[TODO — was "Hides in the Dark"]',
      '[TODO — was "Role-ically"]',
      '[TODO — was "Good Wine Needs No Label?"]',
    ],
  },
  {
    n: 3,
    icon: '⚓',
    name: 'Stormproof Your Vessel',
    subtitle: 'paid — action',
    description: '[TODO: turning insight into motion — obstacles, resources, a concrete plan, and staying in motion when the weather changes.]',
    lessons: [
      '[TODO — was "To Plan. To Write Down. To Act." (part 1)]',
      '[TODO — was "Hands Up"]',
      '[TODO — was "To Plan. To Write Down. To Act." (part 2)]',
      '[TODO — was "Provisions for the Road"]',
    ],
  },
];
---

<Layout title="The Program">
  <section style="max-width: 720px;">
    <p style="font-family: var(--font-sans); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 var(--space-2);">
      Placeholder copy — structure decided, wording not
    </p>
    <h1 style="font-size: 36px; font-weight: 400; margin: 0 0 var(--space-3);">The Wayfinder Method</h1>
    <p style="font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 var(--space-1); font-style: italic;">
      Find your bearings. Wake up your inner navigator. Rechart your course and find your other map. Stormproof your vessel. Set sail.
    </p>
    <p style="font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 var(--space-4);">
      [TODO: intro paragraph. Core idea — you don't need someone to tell you where to go, you need to know how to navigate. One free entry stage, then three paid stages below, each carrying several of the original 15 lessons. See /brand/product/RECHART.md for the full mapping and rationale.]
    </p>

    <div style="margin: 0 0 var(--space-5); padding: var(--space-3); background: var(--color-surface); border-radius: var(--radius); border: 1px solid var(--color-border);">
      <div style="display: flex; align-items: baseline; gap: var(--space-2); margin: 0 0 var(--space-1);">
        <span style="font-size: 20px;">{freeStage.icon}</span>
        <h2 style="font-size: 22px; font-weight: 400; margin: 0;">{freeStage.name}</h2>
        <span style="font-family: var(--font-sans); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted);">{freeStage.subtitle}</span>
      </div>
      <p style="font-family: var(--font-sans); font-size: 15px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 var(--space-2);">
        {freeStage.description}
      </p>
      <p style="font-family: var(--font-display, var(--font-sans)); font-style: italic; font-size: 17px; margin: 0;">
        &ldquo;{freeStage.quote}&rdquo;
      </p>
    </div>

    <p style="font-family: var(--font-sans); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 var(--space-4);">
      Full package: {PRICE_FULL} ({PRICE_LAUNCH} at launch) — includes Find Your Bearings above, not sold separately
    </p>

    {phases.map((phase) => (
      <div style="margin: 0 0 var(--space-4);">
        <div style="display: flex; align-items: baseline; gap: var(--space-2); margin: 0 0 var(--space-1);">
          <span style="font-size: 20px;">{phase.icon}</span>
          <h2 style="font-size: 22px; font-weight: 400; margin: 0;">{phase.n}. {phase.name}</h2>
          <span style="font-family: var(--font-sans); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted);">{phase.subtitle}</span>
        </div>
        <p style="font-family: var(--font-sans); font-size: 15px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 var(--space-2);">
          {phase.description}
        </p>
        <ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-1);">
          {phase.lessons.map((lesson) => (
            <li style="padding: var(--space-1) var(--space-3); border-bottom: 1px solid var(--color-border);">
              <span style="font-family: var(--font-sans); font-size: 15px; color: var(--color-text-muted);">{lesson}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</Layout>

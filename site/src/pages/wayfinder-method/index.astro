---
import Layout from '../../layouts/Layout.astro';

// Sales landing page for RECHART / The Wayfinder Method.
// Copy: edited down from brand/copy/LANDING-COPY-SUGGESTION-V0-SOPHIE.md —
// cut the mechanical triplets and "not X, not Y, but Z" patterns, varied
// sentence rhythm, kept the lines Sophie flagged as hers (coffee machine,
// "best self has had enough meetings", 5am cold showers, "That's life.").
// This is an edited English draft, not a verified Sophie-voice pass — she
// should still read it in her own voice before it's final.
// Images: brand/visual/landing-images/ (ChatGPT-generated, Harbor Light
// style), compressed to webp in /public/images/wayfinder/. Batch 2 (people
// and scenes) added 2026-11-02 — see that README for the full catalogue.
// Deliberately NOT used: pier-feet-over-water-wide.webp (has a ladder in
// frame — the cube/ladder/lion test is a core, untouchable brand element
// per RECHART.md, and a decorative ladder here risks pre-empting or
// confusing it before someone's actually taken the test) and
// helm-closeup-crop.webp (misleading name, no storm in it, redundant with
// the portrait crop of the same scene).
// Structure + pricing per /brand/product/RECHART.md and COORDINATION.md
// (final decision 2026-11-01): Find Your Bearings is a free taste embedded
// on this page, and also stage 1 of the paid package — not a separate funnel.
//
// Background color (--hl-paper below) is the MEASURED average corner color
// of the 5 landing images (sampled with ImageMagick, 2026-11-01): ~#FBF1E3.
// Must stay matched to whatever paper tone future image batches use, or the
// images will read as boxes again instead of sitting flush on the page.
//
// DESKTOP-ONLY PASS (2026-11-02, per Sophie's request): this round adds (1)
// many more images scattered through the sections, (2) a bead cluster where
// the four Wayfinder Method parts visually sit on a short static arc (not
// the full-page thread — see note by .bead-cluster below for why), and (3)
// more thread waypoints so the long thread weaves around text blocks
// instead of running close to straight. Mobile is NOT reworked yet — the
// scatter images and bead cluster are desktop-only (hidden under 900px) on
// purpose, because a winding desktop path and scattered off-column images
// don't translate directly to a 390px-wide screen; that geometry needs its
// own simpler pass once this desktop version is approved, the same way
// criticalthinkinghu's ArcConnector.tsx has entirely separate wide/narrow
// logic rather than one shared geometry.
const PRICE_FULL = '£69';
const PRICE_LAUNCH = '£39';
---

<Layout
  title="The Wayfinder Method"
  description="RECHART · The Wayfinder Method — a quieter way to figure out your next direction, not your next life."
>
  <article class="wayfinder">
    <div class="watercolor-decor" aria-hidden="true">
      <svg class="blob blob-copper blob-a" viewBox="0 0 200 200"><path fill="#B87345" d="M48,-58.6C62.2,-49.4,73.1,-33.8,76.8,-16.6C80.5,0.7,76.9,19.6,67.2,34.6C57.6,49.7,41.8,60.8,24.3,66.4C6.8,72.1,-12.5,72.2,-28.8,65.3C-45.1,58.3,-58.4,44.3,-65.8,27.4C-73.2,10.6,-74.7,-9.1,-67.8,-25.2C-60.9,-41.3,-45.5,-53.9,-29.7,-62.2C-13.9,-70.5,2.3,-74.5,18.1,-71.5C33.9,-68.5,33.7,-67.9,48,-58.6Z" transform="translate(100 100)"/></svg>
      <svg class="blob blob-blue blob-b" viewBox="0 0 200 200"><path fill="#7FA8C9" d="M44.1,-54.5C56.4,-45.5,64.7,-30.3,67.6,-14.2C70.6,1.9,68.2,18.8,59.8,32.1C51.4,45.4,37,55,21.1,60.8C5.2,66.6,-12.2,68.6,-27.9,63.6C-43.5,58.6,-57.4,46.6,-65.1,31.5C-72.8,16.4,-74.4,-1.8,-69.1,-17.5C-63.9,-33.2,-51.8,-46.3,-37.7,-55.1C-23.6,-63.9,-11.8,-68.4,2.6,-71.6C17,-74.9,31.8,-63.5,44.1,-54.5Z" transform="translate(100 100)"/></svg>
      <svg class="blob blob-copper blob-c" viewBox="0 0 200 200"><path fill="#B87345" d="M39.6,-49.3C50.3,-41.9,57.3,-28.9,60.6,-14.6C63.9,-0.3,63.5,15.3,56.9,28.1C50.3,40.9,37.5,50.9,23.2,56.8C8.9,62.7,-6.9,64.5,-21.6,60.2C-36.3,55.9,-49.9,45.5,-58.1,31.5C-66.3,17.5,-69.1,-0.1,-64.6,-15.2C-60.1,-30.3,-48.3,-42.9,-35,-50.1C-21.7,-57.3,-6.9,-59.1,5.9,-57.7C18.7,-56.3,28.9,-56.7,39.6,-49.3Z" transform="translate(100 100)"/></svg>
      <svg class="blob blob-blue blob-d" viewBox="0 0 200 200"><path fill="#1C4F6B" d="M35.8,-45.5C46.1,-38.6,53.6,-27,57.4,-13.7C61.2,-0.4,61.3,14.6,55.4,26.9C49.5,39.2,37.6,48.8,24.2,54.6C10.8,60.4,-4.1,62.4,-18.3,58.8C-32.5,55.2,-46,46,-54.4,33.1C-62.8,20.2,-66.1,3.6,-62.9,-11.3C-59.7,-26.2,-50,-39.4,-37.5,-46.4C-25,-53.4,-9.7,-54.2,2.9,-57.8C15.5,-61.4,25.5,-52.4,35.8,-45.5Z" transform="translate(100 100)"/></svg>
      <svg class="dots dots-a" viewBox="0 0 120 60"><circle cx="10" cy="10" r="3" fill="#B87345"/><circle cx="28" cy="22" r="1.8" fill="#B87345"/><circle cx="45" cy="8" r="2.4" fill="#7FA8C9"/><circle cx="60" cy="30" r="1.4" fill="#B87345"/><circle cx="78" cy="14" r="2" fill="#7FA8C9"/><circle cx="95" cy="26" r="1.6" fill="#B87345"/><circle cx="18" cy="45" r="1.4" fill="#7FA8C9"/></svg>
      <svg class="dots dots-b" viewBox="0 0 120 60"><circle cx="100" cy="12" r="2.6" fill="#1C4F6B"/><circle cx="82" cy="28" r="1.6" fill="#B87345"/><circle cx="65" cy="10" r="2" fill="#B87345"/><circle cx="48" cy="32" r="1.4" fill="#1C4F6B"/><circle cx="30" cy="16" r="1.8" fill="#B87345"/><circle cx="12" cy="30" r="1.2" fill="#1C4F6B"/></svg>
    </div>

    <!-- HERO -->
    <section class="hero">
      <img
        class="hero-image"
        data-thread-start
        src="/images/wayfinder/hero-sailboat-sunset-banner.webp"
        alt="A small wooden sailboat crossing calm water at sunset, watercolor illustration"
        width="1600" height="533"
      />
      <div class="hero-text">
        <p class="eyebrow">RECHART · The Wayfinder Method</p>
        <h1>BECALMED?</h1>
        <p class="lede">Maybe you don't need a new life. You need a different bearing.</p>
        <p>
          You've got a job, people who need you, a life that mostly works. (Even a coffee machine
          you've made peace with.) And still — something's off. Not broken. Just off.
        </p>
        <p>This is a quieter way to figure out what's next, before you do anything drastic.</p>
        <a class="btn btn-primary" href="#find-your-bearings">Find Your Bearings — free</a>
      </div>
    </section>

    <div class="thread-wp-row wp-right"><span data-thread-waypoint></span></div>

    <!-- RECOGNITION -->
    <section class="prose prose-scatter">
      <img
        data-thread-point
        class="scatter-img scatter-right"
        src="/images/wayfinder/woman-sitting-thinking-bun.webp"
        alt="A woman sitting cross-legged, chin on hand, looking up and away, watercolor illustration"
        width="500" height="500"
      />
      <h2>Not in a storm. Just stuck.</h2>
      <p>Nothing's really wrong. Nothing's really right either.</p>
      <p>
        You keep going, because that's what you do — you handle things, you make it work, you've
        gotten disturbingly good at it. And somewhere in all that functioning, a small, annoying
        voice keeps asking: <em>is this still what I want?</em>
      </p>
      <p>
        Maybe you've outgrown who you used to be. Maybe your priorities rearranged themselves
        without asking you first. Or maybe you genuinely don't know what's going on — and that's
        fine too.
      </p>
      <p>You don't need a crisis to change direction. You don't even need an answer yet. You need a different question.</p>
    </section>

    <div class="thread-wp-row wp-left"><span data-thread-waypoint></span></div>

    <!-- REFRAME -->
    <section class="prose prose-surface prose-scatter">
      <img
        data-thread-point
        class="scatter-img scatter-left"
        src="/images/wayfinder/man-wiping-foggy-window.webp"
        alt="A man seen from behind wiping a foggy window clear, watercolor illustration"
        width="500" height="500"
      />
      <h2>You don't need to fix your life. You need to reconnect with it.</h2>
      <p>
        A reset isn't starting over. It's stepping back far enough to actually see what's
        happening — what matters now, what gives you energy, what you've been carrying out of
        habit because nobody ever told you that you could put it down.
      </p>
      <p>
        Then, instead of making seventeen decisions in one over-caffeinated weekend, you explore.
        Slowly. On purpose.
      </p>
      <p class="standout">This is not a five-step plan to become your best self.<br>Your best self has probably had enough meetings already.</p>
    </section>

    <div class="thread-wp-row wp-right"><span data-thread-waypoint></span></div>

    <!-- METHOD -->
    <section class="prose">
      <p class="eyebrow">The method</p>
      <h2>Meet your inner Wayfinder</h2>
      <p>
        The Wayfinder Method is a guided way through change, from the inside out. Not someone
        else's map, not a poster that says "just follow your passion" — it's built around your
        own signals: noticing them, trusting them enough to use them, and turning that into
        something you actually do.
      </p>
    </section>

    <!-- BEAD CLUSTER — the four parts riding a short arc of their own.
         NOT wired into the page-long thread script: that thread is built by
         measuring images in DOM order and smoothing a curve through them,
         which works for a vertical sequence of far-apart points, not four
         tightly clustered circles that want a specific tidy wave shape.
         Giving this its own small static SVG (hand-tuned to match the bead
         offsets below) is simpler and more reliable than forcing one
         geometry function to do both jobs. -->
    <section class="bead-cluster">
      <svg class="bead-arc" viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M 20,30 C 60,85 100,85 140,45 C 170,15 190,10 210,35 C 235,65 260,70 285,40 C 310,10 340,10 380,32"
          fill="none" stroke="var(--hl-copper)" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="1 7" />
      </svg>
      <div class="bead" style="--bead-y: -18px;">
        <img src="/images/wayfinder/sextant.webp" alt="" width="200" height="200" />
        <span>Find Your Bearings</span>
      </div>
      <div class="bead" style="--bead-y: 20px;">
        <img src="/images/wayfinder/compass-copper-route.webp" alt="" width="200" height="200" />
        <span>Wake Up the Inner Navigator</span>
      </div>
      <div class="bead" style="--bead-y: -8px;">
        <img src="/images/wayfinder/map-quill-hand.webp" alt="" width="200" height="200" />
        <span>Draw Your Other Map</span>
      </div>
      <div class="bead" style="--bead-y: 18px;">
        <img src="/images/wayfinder/anchor-rope-waves.webp" alt="" width="200" height="200" />
        <span>Stormproof Your Vessel</span>
      </div>
    </section>

    <div class="thread-wp-row wp-left"><span data-thread-waypoint></span></div>

    <section class="stages">
      <div class="stage">
        <img data-thread-point src="/images/wayfinder/compass-copper-route.webp" alt="A brass compass with a copper route line, watercolor illustration" width="800" height="800" />
        <div>
          <p class="stage-num">01</p>
          <h3>Wake Up the Inner Navigator</h3>
          <p>
            First, notice where you actually are. Before you plan the next move, get curious
            about who's doing the navigating — your patterns, the running commentary in your
            head, what actually gives you energy versus what you've just always done.
          </p>
          <p>Because the voice in your head isn't always wisdom. Sometimes it's just your downstairs neighbour, and they have opinions about everything.</p>
        </div>
      </div>

      <div class="thread-wp-row wp-right"><span data-thread-waypoint></span></div>

      <div class="stage stage-reverse">
        <img data-thread-point src="/images/wayfinder/map-quill-hand.webp" alt="A hand sketching a route onto a map with a quill, watercolor illustration" width="800" height="800" />
        <div>
          <p class="stage-num">02</p>
          <h3>Draw Your Other Map</h3>
          <p>
            Then, sketch where you might want to go. Reconnect with what matters to you, not what
            you were handed. Look at the ideas you dismissed too fast, the things you buried under
            "should."
          </p>
          <p>None of it has to be the grand answer. It just has to be worth walking toward.</p>
        </div>
      </div>

      <div class="thread-wp-row wp-left"><span data-thread-waypoint></span></div>

      <div class="stage">
        <img data-thread-point src="/images/wayfinder/anchor-rope-waves.webp" alt="An anchor with coiled rope resting against gentle waves, watercolor illustration" width="800" height="800" />
        <div>
          <p class="stage-num">03</p>
          <h3>Stormproof Your Vessel</h3>
          <p>
            Finally, turn the insight into motion. Gather what you've already got. Name the
            obstacles before they surprise you. Build a plan that's actually yours, not some
            version of you who wakes up at 5am for a cold shower.
          </p>
          <p>Weather changes. That's not a character flaw. That's life.</p>
        </div>
      </div>
    </section>

    <!-- CALM PORTRAIT DIVIDER -->
    <section class="portrait-divider">
      <img data-thread-point src="/images/wayfinder/helm-woman-wind-portrait.webp" alt="A woman at a ship's wheel, hair in the wind, calm expression, watercolor illustration" width="500" height="700" />
      <p class="standout">The answer to the storm isn't a fight.<br>It's a steady hand on the wheel.</p>
    </section>

    <div class="thread-wp-row wp-right"><span data-thread-waypoint></span></div>

    <!-- FREE TASTE / FIND YOUR BEARINGS -->
    <section id="find-your-bearings" class="taste">
      <img data-thread-point src="/images/wayfinder/sextant.webp" alt="A brass sextant catching the light, watercolor illustration" width="800" height="800" class="taste-image" />
      <div>
        <p class="eyebrow">Try it first — free</p>
        <h2>Find Your Bearings</h2>
        <p>
          A short, free exercise — a handful of prompts about what you actually notice, not what
          label you'd like to wear. No quiz result that tells you you're a Blue Dolphin.
        </p>
        <p>Leave your email, get your results, see if this whole thing is even worth your time.</p>
        <a class="btn btn-primary" href="#">Find Your Bearings — free</a>
        <p class="fine-print">It's also the opening stage of the full course below — nothing you do here gets wasted if you decide to go further.</p>
      </div>
    </section>

    <div class="thread-wp-row wp-left"><span data-thread-waypoint></span></div>

    <!-- FULL JOURNEY / PRICING -->
    <section class="pricing prose-scatter">
      <img
        data-thread-point
        class="scatter-img scatter-left"
        src="/images/wayfinder/travel-trunk-map-boots.webp"
        alt="An open travel trunk with a compass rose, map, scarf and worn boots, watercolor illustration"
        width="500" height="500"
      />
      <p class="eyebrow">Ready to go further?</p>
      <h2>The Wayfinder Method — full course</h2>
      <p>
        Fifteen lessons, delivered over about four weeks, building from Find Your Bearings above
        through all three stages. You get the full workbook at the end too.
      </p>
      <p class="price">
        <span class="price-launch">{PRICE_LAUNCH}</span>
        <span class="price-full">{PRICE_FULL} full price</span>
      </p>
      <a class="btn btn-primary" href="#">Start The Wayfinder Method</a>
      <p class="standout" style="margin-top: var(--space-3);">Not a personality makeover. Not a universal life recipe.<br>A practical way back into your own life, at a pace you set.</p>
    </section>

    <div class="thread-wp-row wp-right"><span data-thread-waypoint></span></div>

    <!-- WHO FOR -->
    <section class="prose prose-surface prose-scatter">
      <img
        data-thread-point
        class="scatter-img scatter-right"
        src="/images/wayfinder/man-bow-facing-wind.webp"
        alt="A man at the bow of a sailboat, face up into the wind, watercolor illustration"
        width="500" height="500"
      />
      <h2>This is probably for you if —</h2>
      <ul>
        <li>you're functioning fine, but something feels disconnected</li>
        <li>you know something needs to shift, but can't name it yet</li>
        <li>you've got plenty of ideas and no idea what to do with them</li>
        <li>you want a real change without blowing up your actual life</li>
      </ul>
      <p>You don't have to be lost. You just have to be a little curious.</p>
    </section>

    <div class="thread-wp-row wp-left"><span data-thread-waypoint></span></div>

    <!-- WHAT IT ISN'T -->
    <section class="prose">
      <h2>What this isn't</h2>
      <p>
        A few things, before we set sail. This isn't therapy. It isn't a diagnosis. It's not going
        to hand you the one true purpose you were apparently supposed to find since birth.
      </p>
      <p>It's a space to think, try things, and actually act on what you find.</p>
      <p class="standout">You bring your life. We bring a method. The direction's yours.</p>
    </section>

    <div class="thread-wp-row wp-right"><span data-thread-waypoint></span></div>

    <!-- PHILOSOPHY -->
    <section class="prose prose-surface">
      <h2>You don't need the whole map before you start.<br>You need enough awareness to choose the next step.</h2>
      <p>
        Life doesn't usually hand you a full set of coordinates. Sometimes you move with total
        clarity. Sometimes you're guessing. Sometimes you get halfway somewhere and realise that
        destination belonged to an earlier version of you.
      </p>
      <p>
        That's allowed. You can change your mind, take the long way, or just stop for a while
        without calling the whole thing a failure.
      </p>
      <p>You can redraw the map. That's the whole point.</p>
    </section>

    <!-- BOARDING / FIRST STEP -->
    <section class="boarding">
      <img data-thread-point src="/images/wayfinder/boarding-sailboat-from-pier.webp" alt="A figure in a blue coat stepping from a pier onto a sailboat, watercolor illustration" width="1200" height="800" />
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <h2>Your life doesn't need a plot twist.<br>Just a bit of room to reconsider what's next.</h2>
      <a class="btn btn-primary" href="#find-your-bearings" data-thread-end>Find Your Bearings — free</a>
      <p class="tagline">RECHART · The Wayfinder Method</p>
    </section>

    <svg class="thread-svg" aria-hidden="true"></svg>
  </article>
</Layout>

<script>
  // "Cérnavonal" thread — adapted from criticalthinkinghu's ArcConnector.tsx:
  // a measured, Catmull-Rom-smoothed SVG path that starts at the hero image
  // and runs down through each [data-thread-point] image (and invisible
  // [data-thread-waypoint] markers placed in the margins between sections,
  // which pull the curve into wider swings so it reads as weaving around
  // the text blocks rather than running straight down behind them) to
  // [data-thread-end]. This is a plain-JS port (that component is React)
  // and a first guess at the geometry — Sophie is sketching her own
  // preferred line shape by hand to refine this further.
  type Pt = { x: number; y: number };

  function pagePos(el: HTMLElement, root: HTMLElement): Pt {
    let x = 0, y = 0, n: HTMLElement | null = el;
    while (n && n !== root) {
      x += n.offsetLeft;
      y += n.offsetTop;
      n = n.offsetParent as HTMLElement | null;
    }
    return { x, y };
  }

  function smooth(points: Pt[]): string {
    const tangent = (i: number): Pt =>
      i === 0
        ? { x: points[1].x - points[0].x, y: points[1].y - points[0].y }
        : i === points.length - 1
          ? { x: points[i].x - points[i - 1].x, y: points[i].y - points[i - 1].y }
          : { x: (points[i + 1].x - points[i - 1].x) / 2, y: (points[i + 1].y - points[i - 1].y) / 2 };
    let d = "";
    for (let i = 0; i < points.length - 1; i++) {
      const a = points[i], b = points[i + 1];
      const ta = tangent(i), tb = tangent(i + 1);
      d += ` C ${a.x + ta.x / 3} ${a.y + ta.y / 3} ${b.x - tb.x / 3} ${b.y - tb.y / 3} ${b.x} ${b.y}`;
    }
    return d;
  }

  function draw() {
    const wrapper = document.querySelector<HTMLElement>('.wayfinder');
    const svg = document.querySelector<SVGSVGElement>('.thread-svg');
    if (!wrapper || !svg) return;
    if (window.innerWidth < 900) { svg.innerHTML = ''; return; } // desktop-only pass, see top-of-file note

    const startEl = wrapper.querySelector<HTMLElement>('[data-thread-start]');
    const waypointEls = Array.from(wrapper.querySelectorAll<HTMLElement>('[data-thread-point], [data-thread-waypoint]'));
    const endEl = wrapper.querySelector<HTMLElement>('[data-thread-end]');
    if (!startEl || !endEl || waypointEls.length === 0) return;

    const center = (el: HTMLElement): Pt => {
      const p = pagePos(el, wrapper);
      return { x: p.x + el.offsetWidth / 2, y: p.y + el.offsetHeight / 2 };
    };
    // Start near the boat (left side of the hero image), not its center.
    const startPos = pagePos(startEl, wrapper);
    const start: Pt = { x: startPos.x + startEl.offsetWidth * 0.22, y: startPos.y + startEl.offsetHeight * 0.7 };
    const points: Pt[] = [start, ...waypointEls.map(center), center(endEl)];

    const d = `M ${start.x} ${start.y}${smooth(points)}`;
    svg.setAttribute('width', String(wrapper.offsetWidth));
    svg.setAttribute('height', String(wrapper.offsetHeight));

    const path = svg.querySelector('path') ?? document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', 'var(--hl-copper, #B87345)');
    path.setAttribute('stroke-width', '1.75');
    path.setAttribute('stroke-linecap', 'round');
    path.setAttribute('stroke-dasharray', '1 7');
    if (!path.parentElement) svg.appendChild(path);

    svg.querySelectorAll('circle[data-thread-dot]').forEach((n) => n.remove());
    // Only dot the real image points, not the invisible waypoint markers.
    const imagePoints = Array.from(wrapper.querySelectorAll<HTMLElement>('[data-thread-point]')).map(center);
    for (const p of imagePoints) {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('data-thread-dot', '');
      c.setAttribute('cx', String(p.x));
      c.setAttribute('cy', String(p.y));
      c.setAttribute('r', '3');
      c.setAttribute('fill', 'var(--hl-copper, #B87345)');
      c.setAttribute('opacity', '0.8');
      svg.appendChild(c);
    }
  }

  function init() {
    draw();
    const wrapper = document.querySelector<HTMLElement>('.wayfinder');
    if (wrapper) new ResizeObserver(() => draw()).observe(wrapper);
    window.addEventListener('load', draw);
    window.addEventListener('resize', draw);
    (document as any).fonts?.ready?.then(draw);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  /* Harbor Light — the RECHART-specific nautical layer on top of the site's
     King's Cross Light palette. See /brand/visual/VISUAL-DIRECTION.md. */
  .wayfinder {
    --hl-contour: #142230;
    --hl-blue: #1C4F6B;
    --hl-blue-dusty: #7FA8C9;

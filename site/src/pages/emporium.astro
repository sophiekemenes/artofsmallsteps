---
// The Emporium of Small Adventures: WORK-IN-PROGRESS preview (noindex, linked from nowhere).
// Built from the Design canvas wireframe (https://claude.ai/artifact/4tP7N67oGGDnzUmB7ikfUG,
// Main + Mobile artboards) and emporium/assets/. Copy: approved by Sophie 2026-11-21, source in
// emporium/copy/ (emporium-copy session). Counter: pinches come from src/data/emporium-pinches.json,
// generated by site/tools/emporium_pinches.py from emporium/copy/01-missions-en.md. Signup not wired yet.
import pinches from '../data/emporium-pinches.json';
import Tracking from '../components/Tracking.astro';
const shelves = [
  { name: 'Salt', story: `Salt doesn't show off. You only notice it when it's missing. These pinches are for days that have come a bit unstitched: one drawer put in order, three sounds you actually listen to, a stretch before the next thing. Plain, small, and oddly steadying. Like a mended sock. (Yes, people still mend socks. With a darning mushroom, no less. I checked.)`, line: 'grounding, the basics put right', img: 'salt', alt: 'Salt shelf: a darning mushroom with a half-darned sock, a worn wooden spoon, unlaced boots, a jar of coarse salt, a dented tin alarm clock' },
  { name: 'Sweet', story: `Sweet is kindness, and some of it is for other people: a thank-you you didn't plan, a door held, a song passed on. But a fair share of it is for you. Five minutes that don't have to be useful. A biscuit eaten slowly, on purpose. You're allowed to be on your own list.`, line: 'kindness, something you give yourself', img: 'sweet', alt: 'Sweet shelf: a plant in a teacup, a biscuit with one bite gone, a hot-water bottle, flowers, sugar cubes' },
  { name: 'Sour', story: `This is the cheeky shelf. It belongs to the kid you used to be (and, let's be honest, still are on a good day). A jar of keys that open nothing, a catapult, a rubber stamp for approving things nobody asked you to approve. The pinches here are small acts of mischief: odd socks, a secret note, narrating the laundry like a wildlife film. Every now and then one of them makes the world look curiously innocent again. Which is no small thing. Play is the most serious thing we do. Nobody gets hurt. Somebody, probably you, grins.`, line: 'mischief, cheek, a little impudence', img: 'sour', alt: 'Sour shelf: a jar of keys, a catapult, a rubber stamp, a door knocker' },
  { name: 'Bitter', story: `The envelope you haven't opened. The mirror turned face down. The "one day" that never quite gets a date. These bitter-flavoured pinches won't ask you to fix anything, but there's a chance they'll ask you to look, for a minute, at the thing you've been politely ignoring. Bitter is an acquired taste. So is honesty. (The cat hanging off this shelf has opinions about both.)`, line: 'what you keep walking past', img: 'bitter-with-cat', alt: 'Bitter shelf: a mirror turned face down, an unopened envelope, a skipping rope, coffee beans, a clock without hands, and a ginger cat hanging off the edge' },
  { name: 'Chilli', story: `You know that moment when you very nearly did it, all by yourself. And then you flinched, and stepped back. These pinches are for getting past the flinch. A message after a long silence. Five minutes of something you're a complete beginner at. Saying the nice thing out loud instead of only thinking it. None of it is a mountain. It's more like the first bite of a chilli: your face does something alarming, and then you're glad you tasted it. Got your courage on you?`, line: 'courage, and a bit of risk', img: 'spice', alt: 'Chilli shelf: a roller skate, a matchbox with a burnt match, a rolled-up map, a bicycle bell, dried chillies' },
  { name: 'A new pan', story: `Sometimes the recipe is fine, the ingredients are in place, and the spices are in just the right proportion. It's only the pan that's tired. When you reach in for a pinch and get one of these, it's gonna ask you to change the tool or the place: a different route, a book picked for its title, an ordinary object studied like a visitor from another planet. Same you, same day, new tool. (Kormi, the black cat asleep on this shelf, has a very refined taste for things that come out of a new pan. It's not related to your adventures. I just wanted you to know.)`, line: 'a change of tool, or of place', img: 'new-pan-with-cat', alt: 'New pan shelf: a sleeping black cat, a pan with ivy growing in it, a telescope, a jar of bus tickets, a teapot with a cactus' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>The Emporium of Small Adventures · work in progress</title>
<meta name="description" content="Work-in-progress preview of The Emporium of Small Adventures, an Art of Small Steps programme." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Lora:ital,wght@0,400;0,600;1,400&family=Shadows+Into+Light+Two&display=swap" />
<style is:global>
:root{--paper:#FBF1E3;--paper-light:#FFF8EE;--text:#141413;--teal:#123C3B;--rust:#A4492F;--hair:#D9C7AC;--counter:#093B3A}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--text);font-family:'Lora',Georgia,serif;overflow-x:hidden}
a{color:var(--rust)}a:hover{color:#6E3219}
.display{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500}
.hand{font-family:'Shadows Into Light Two',cursive}
.wip{background:var(--teal);color:#F6ECD8;font-size:14px;text-align:center;padding:9px 16px;line-height:1.5}
.wip b{color:#F2C9A0;font-weight:600}
.todo{border:1.5px dashed #C9B9A3;border-radius:8px;padding:16px 18px;color:#6B6156;font-size:15px;line-height:1.55;font-style:italic;background:rgba(255,248,238,.5)}
.sign{display:flex;flex-direction:column;align-items:center;padding:0 16px}
.sign img{width:min(620px,100%);height:auto;display:block}
.sign p{margin:4px 0 0;font-size:18px;color:#3F3A32;text-align:center}
.intro{max-width:600px;margin:34px auto 40px;padding:0 16px}
.counter{background:var(--counter);padding:0 0 30px}
.counter-stage{position:relative}
.counter-stage img{width:100%;height:auto;display:block}
.pinch{position:absolute;bottom:25%;left:50%;transform:translateX(-50%) rotate(-1.2deg);width:min(430px,86%);background:var(--paper-light);border:1px solid var(--hair);padding:16px 22px;text-align:center}
.pinch .eyebrow{font-family:system-ui,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--rust)}
.pinch .task{font-size:19px;line-height:1.4;color:var(--teal);padding-top:6px}
.counter-actions{display:flex;flex-direction:column;align-items:center;gap:12px;padding:24px 16px 0}
.btn-ghost{min-height:48px;padding:0 30px;border:1px solid #E7D7B8;background:transparent;font:inherit;font-size:14px;letter-spacing:1.6px;color:#F6ECD8;cursor:pointer;transition:background .2s}
.btn-ghost:hover,.btn-ghost:focus-visible{background:rgba(246,236,216,.1)}
.counter-actions a{font-size:14px;color:#D8B48E}
.pinch .eyebrow:empty{display:none}
.pinch .task{transition:opacity .25s}
.pinch.swap .task{opacity:0}
.again{margin:0;font-size:14px;font-style:italic;color:#D8B48E;text-align:center}
.enough{max-width:460px;margin:0;font-size:16px;line-height:1.6;color:#F6ECD8;text-align:center}
.enough a{color:#F2C9A0}
[hidden]{display:none!important}
.eyebrow-sec{font-family:system-ui,sans-serif;font-size:12px;letter-spacing:1.6px;text-transform:uppercase;color:#6B6156;text-align:center;margin:44px 0 18px}
.shelf{display:flex;align-items:center;gap:48px;margin:0 0 40px}
.shelf .pic{width:440px;flex:none;overflow:hidden}
.shelf .pic img{width:490px;max-width:none;height:auto;display:block}
.shelf.l{padding-right:80px}.shelf.l .pic img{margin-left:-50px}
.shelf.r{padding-left:80px;flex-direction:row-reverse}.shelf.r .pic img{margin-left:0}
.shelf .txt{flex:1;max-width:560px}
.shelf.r .txt{margin-left:auto}
.shelf h3{margin:0;font-size:32px;color:var(--teal);line-height:1.1}
.shelf .line{margin:2px 0 12px;font-size:16px;color:var(--rust)}
.shelf .tale{margin:0;font-size:16px;line-height:1.65}
.intro p{margin:0 0 14px;font-size:18px;line-height:1.65}
.story .body{padding:0 16px 6px}.story .body p{margin:0 0 12px;line-height:1.65}
.keeper .note{text-align:left;width:100%}.keeper .note p{margin:0 0 14px;line-height:1.65}
.keeper h3{margin:18px 0 0;font-size:26px;color:var(--teal)}
.keeper .soft{font-size:15px;color:#6B6156;margin:0}
.toto{width:min(340px,82%);height:auto;display:block;margin:6px 0 -16px;position:relative;z-index:1;pointer-events:none}
.keeper form{position:relative;padding-top:6px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.stock{display:flex;align-items:center;gap:56px;padding:30px 0 30px 80px;border-top:1px dashed #C9C7BE;border-bottom:1px dashed #C9C7BE;overflow:hidden}
.stock .txt{flex:1}.stock .pic{width:520px;flex:none;margin-right:-60px}.stock .pic img{width:100%;height:auto;display:block}
.story{max-width:680px;margin:40px auto;padding:0 16px}
.story details{border:1px solid var(--hair);background:var(--paper-light);margin:0 0 8px;border-radius:4px}
.story summary{cursor:pointer;padding:14px 16px;font-size:17px;color:var(--teal)}
.story details .todo{margin:0 16px 16px}
.keeper{max-width:600px;margin:50px auto 70px;padding:0 16px;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center}
.keeper form{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;width:100%}
.keeper input{min-height:48px;flex:1 1 240px;max-width:320px;padding:0 14px;border:1px solid #C9C7BE;background:var(--paper-light);font:inherit;font-size:15px}
.keeper button{min-height:48px;padding:0 22px;border:1px solid var(--teal);background:transparent;font:inherit;font-size:14px;letter-spacing:1.2px;color:var(--teal);cursor:not-allowed}
footer{border-top:1px solid var(--hair);padding:22px 16px 34px;text-align:center;font-size:14px;color:#6B6156}
@media (max-width:900px){
  .shelf,.shelf.l,.shelf.r{flex-direction:column;gap:6px;padding:0;margin-bottom:30px}
  .shelf .pic{width:100%}
  .shelf .pic img{width:114%}
  .shelf.l .pic img{margin-left:-14%}
  .shelf .txt,.shelf.r .txt{padding:0 16px;text-align:center;width:100%;margin:0}
  .shelf h3{font-size:26px}
  .stock{flex-direction:column-reverse;padding:18px 0 22px;gap:10px}
  .stock .pic{width:100%;margin:0;overflow:hidden}.stock .pic img{width:126%;max-width:none}
  .stock .txt{padding:0 16px;width:100%}
  .pinch{position:relative;bottom:auto;left:auto;transform:rotate(-1.2deg);width:auto;margin:-42px 22px 0;z-index:2}
  .pinch .task{font-size:16px}
  .btn-ghost{width:100%}
}
</style>
</head>
<body>
<div class="wip"><b>Work in progress.</b> The words and illustrations are real. The signup doesn't work yet.</div>

<header class="sign" id="top">
<img src="/emporium/sign-cutout.webp" alt="A hanging shop sign on chains: Sophie presents The Emporium of gloriously unnecessary Small Adventures" width="1536" height="1024" />
<p>Spices for whatever life serves you.</p>
</header>

<section class="intro">
<p>Come in. This is a small shop with one intent only: to give you pinches of adventure. Doses of well-deserved peace or excitement. A dash of random spice that you can add to your life. You have your days. Life gives you various fruits. I give you a nudge, and permission to make guacamole, or a protein shake, or singing lemonade out of them.</p>
<p>I'm Sophie, and I keep the shop. It's free, it's always open, and nobody's keeping count. Come and dig into the jars, and take your first pinch. You're gonna love it.</p>
</section>

<section class="counter" id="counter" aria-label="Today's pinch">
<div class="counter-stage">
<img src="/emporium/counter-on-teal.webp" alt="The shop counter: brass scales with empty pans, blank paper labels on a string, a paper bag, a pencil, a pair of glasses, twine" width="2172" height="724" />
<div class="pinch" id="pinch" aria-live="polite">
<div class="eyebrow" id="pinch-eyebrow"></div>
<div class="task" id="pinch-task">Your dose of add-on mystery is waiting. Let the Emporium (as the dedicated hand of the Universe) choose for you.</div>
</div>
</div>
<div class="counter-actions">
<p class="again" id="pinch-again" hidden>Here's today's pinch again. It kept.</p>
<button class="btn-ghost" type="button" id="pinch-btn">TAKE A PINCH</button>
<p class="enough" id="pinch-enough" hidden>Addicted to new flavours, are ya? Don't spoil your appetite. Nobody knows WHY the gods of random give you exactly these spices for today. Take one, or take none if you feel (or don't feel) like it. See you tomorrow?<br /><a href="#signup">(I can send you an email in the morning, if you like.)</a></p>
</div>
</section>

<p class="eyebrow-sec">The flavours · one shelf each</p>
{shelves.map((s, i) => (
<section class={`shelf ${i % 2 ? 'r' : 'l'}`}>
<div class="pic"><img src={`/emporium/${s.img}.webp`} alt={s.alt} loading="lazy" /></div>
<div class="txt">
<h3 class="display">{s.name}</h3>
<p class="line">{s.line}</p>
<p class="tale">{s.story}</p>
</div>
</section>
))}

<section class="stock" hidden>
<div class="txt">
<p class="eyebrow-sec" style="text-align:left;margin:0 0 10px">On the shelf to take home</p>
<div class="todo">The paid things, shown on a shelf, not as a wall of offers.</div>
</div>
<div class="pic"><img src="/emporium/general-stock.webp" alt="The shop's general stock: jars, lavender, spectacles, a chipped cup, a book" loading="lazy" /></div>
</section>

<section class="story">
<p class="eyebrow-sec">The longer story</p>
<details><summary>What is all this?</summary><div class="body"><p>Most days serve you whatever's on the menu. Emails, errands, the same route, the same three thoughts on repeat. Some of it is perfectly good. A fair bit of it is the mental version of junk food: it fills you up, leaves you oddly hungry, and somehow you keep going back for seconds. (So do I. I'm not judging. I sell spices, not diets.)</p><p>The Emporium doesn't take anything off your plate. It hands you one small pinch to add. A different way home. A thank-you you didn't plan. A cloud that looks like a slightly suspicious potato. You put it into your day, and the day tastes a little more like yours. I think this is something most of us need. A lot.</p><p>That's all. It's gloriously unnecessary, and that's rather the point.</p></div></details>
<details><summary>Why is there no daily must-do?</summary><div class="body"><p>Because you have plenty of those already.</p><p>The shop is always open. No closing time, no streak, no little flame that goes out if you miss a day. Come in when you feel like it. Skip a day, or a week, or a month. The shelves will still be here, and so will I.</p><p>If the first pinch doesn't suit you, ask for another. You get three. After the third, the pan on the scales stays empty until tomorrow. Not as a punishment: it just means today your spice will come from somewhere else. Nobody leaves this shop empty-handed.</p><p>And if you take a pinch and your first thought is &ldquo;Sophie, honestly, not today&rdquo;&hellip; then not today. Not everything uncomfortable is growth, and not everything comfortable is laziness. :)</p></div></details>
<details><summary>What do the flavours mean?</summary><div class="body"><p>Every pinch belongs to a flavour. You don't pick it: the Emporium does, the way a good shopkeeper slips something into your bag that you didn't know you needed.</p><p>Salt for when you need your feet back on the ground. Sweet for when you could do with some kindness, including your own. Sour for when you're feeling a bit cheeky. Bitter for the thing you keep walking past. Chilli for a little courage. And a new pan, which isn't a flavour at all, for when the trouble is the same old pan.</p><p>You find out which one you got when the pinch lands on the counter. (The shop is surprisingly good at this.)</p></div></details>
<details><summary>What does it cost?</summary><div class="body"><p>Nothing. All the pinches here are free, and they'll stay free.</p><p>If you'd like a gentle reminder in your inbox each morning, that's free too (it's at the bottom of the page, next to Toto. You'll meet soon enough: Toto's the ginger cat).</p><p>(I might be cooking up something. Something specific. But not now. If you'd be open to a life-culinary experience we'd take on together, just write to me at <a href="mailto:sophie@artofsmallsteps.com">sophie@artofsmallsteps.com</a>.)</p></div></details>
</section>

<section class="keeper" id="signup">
<p class="hand" style="font-size:28px;color:var(--rust);margin:0">Sophie, keeper of the Emporium</p>
<div class="note">
<p>Hello, hon. It's me, the one behind the counter.</p>
<p>I love this shop. I made it for the ordinary days, the ones that are sometimes almost criminally average. I know I've got enough imagination and playfulness to rattle happily along through life. But some days, just getting the existing things done takes so much out of me that I need a little extra spice from outside. And if nobody else was going to make it for me, I decided I'd make it myself. And if you're here, for you too.</p>
<p>There are days when nobody needs a five-step plan, or a whole new life. All you need is one itsy-bitsy little thing to put in, and that's plenty.</p>
<p>So that's what's on my counter right now. Just take a pinch, drop it into your day, and see what it does. If it happens to do nothing at all, that's perfectly fine too. Because there's always tomorrow, and thank heavens (and the genies of the www, and the great superhighways of the internet) this shop never closes. It'll be here when you need it. And it'll be here for me too: you might as well know that I come back regularly myself, for a pinch of randomly generated goodness.</p>
<p>With love,<br />Sophie</p>
<p>P.S. If one day a pinch isn't enough and you'd like to look at the whole map, I also take people on a longer voyage. It's called <a href="/wayfinder-method/">RECHART</a>.</p>
</div>
<h3 class="display">Would you like a little note in the morning?</h3>
<p style="margin:0;line-height:1.65">Once a day I'll send you a short email. There's nothing to do in it and no pinch inside (you collect that at the counter). Just a gentle tap on the shoulder: the shop's open, come and add a little something to your day.</p>
<p class="soft hand" style="font-size:20px">(Type softly. Toto is napping on the form.)</p>
<img class="toto" src="/emporium/toto-sleeping.webp" alt="Toto, a ginger tabby cat, curled up asleep on top of the form" width="1000" height="433" loading="lazy" />
<form id="signup-form" onsubmit="return false">
<label for="nm" class="sr">What should I call you?</label>
<input id="nm" name="name" type="text" maxlength="30" autocomplete="given-name" placeholder="What should I call you?" disabled />
<label for="em" class="sr">Email</label>
<input id="em" name="email" type="email" autocomplete="email" placeholder="name@example.com" disabled />
<button type="button" disabled title="Not working yet">YES, PLEASE</button>
</form>
<p class="soft">One short email each morning. Leave whenever you like: one click, no hard feelings.</p>
</section>

<footer>The Emporium of Small Adventures · an <a href="/">Art of Small Steps</a> programme · preview, not yet open</footer>
<script is:inline define:vars={{ pinches }}>
(function () {
  var KEY = 'aoss-emporium-counter-v1', MAX = 3;
  var d = new Date();
  var today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  var st = { day: today, taken: [], seen: [] };
  try { var raw = JSON.parse(localStorage.getItem(KEY) || 'null'); if (raw && Array.isArray(raw.seen)) st = raw; } catch (e) {}
  if (st.day !== today) { st.day = today; st.taken = []; }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(st)); } catch (e) {} }
  var card = document.getElementById('pinch'), eb = document.getElementById('pinch-eyebrow'),
      task = document.getElementById('pinch-task'), btn = document.getElementById('pinch-btn'),
      again = document.getElementById('pinch-again'), enough = document.getElementById('pinch-enough');
  function byNo(no) { for (var i = 0; i < pinches.length; i++) if (pinches[i].no === no) return pinches[i]; }
  function label() { btn.textContent = st.taken.length === 0 ? 'TAKE A PINCH' : st.taken.length < MAX ? 'ONE MORE PINCH' : "THAT'S YOUR THREE"; }
  function show(p, animate) {
    function put() { eb.textContent = p.flavour + ' · No. ' + p.no; task.textContent = p.text; card.classList.remove('swap'); }
    if (animate) { card.classList.add('swap'); setTimeout(put, 250); } else put();
  }
  function draw() {
    var pool = pinches.filter(function (p) { return st.seen.indexOf(p.no) < 0; });
    if (!pool.length) { st.seen = st.taken.slice(); pool = pinches.filter(function (p) { return st.seen.indexOf(p.no) < 0; }); }
    return pool[Math.floor(Math.random() * pool.length)];
  }
  var NAME_KEY = 'aoss-emporium-name', name = '';
  try { name = (localStorage.getItem(NAME_KEY) || '').trim().slice(0, 30); } catch (e) {}
  // Called by the signup handler once the signup is wired: remembers the name in this browser.
  window.aossRememberName = function (n) { try { n = String(n || '').trim().slice(0, 30); if (n) localStorage.setItem(NAME_KEY, n); else localStorage.removeItem(NAME_KEY); } catch (e) {} };
  if (st.taken.length) { show(byNo(st.taken[st.taken.length - 1]) || draw(), false); again.hidden = false; }
  else if (name && d.getHours() < 12) { again.textContent = 'Morning, ' + name + ". Here's the counter."; again.hidden = false; }
  label();
  btn.addEventListener('click', function () {
    again.hidden = true;
    if (st.taken.length >= MAX) { enough.hidden = false; return; }
    var p = draw(); st.taken.push(p.no); st.seen.push(p.no); save();
    show(p, true); label();
  });
})();
</script>
<Tracking />
</body>
</html>

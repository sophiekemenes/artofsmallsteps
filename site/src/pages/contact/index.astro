---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact" description="How to reach Sophie at Art of Small Steps.">
  <section style="max-width: 640px; margin: 0 auto;">
    <h1 style="font-family: var(--font-serif); font-weight: 500; font-size: 40px; margin: 0 0 var(--space-3);">Write to me</h1>
    <p style="font-size: 17px; line-height: 1.7; color: var(--color-text-muted); margin: 0 0 var(--space-2);">
      The simplest way to reach me is by email: <a href="mailto:hello@artofsmallsteps.com">hello@artofsmallsteps.com</a>
    </p>
    <p style="font-size: 17px; line-height: 1.7; color: var(--color-text-muted); margin: 0;">
      I read everything myself, so give me a day or two to reply.
    </p>
  </section>
</Layout>
